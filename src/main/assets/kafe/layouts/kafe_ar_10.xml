<?xml version="1.0" encoding="utf-8"?>
<!-- Kafe Keyboard: Arabic, 10 columns, based on CleverKeys' Arabic PC (arab_pc).
     Every row is 10 units wide (the shared bottom row already is). Off the main keys, on
     swipe-up (N): ث on ت · ظ on ط · ذ on د · ؤ on و · ئ on ي · لا on ل.
     د and ط move to row 3. Harakat (top-left corners), digits and symbols keep their places. -->
<keyboard name="Arabic 10 (Kafe)" script="arabic" language="ar">
  <row>
    <key key0="ض" key1="&#1614;" key2="1" key3="`" key4="loc esc"/>
    <key key0="ص" key1="&#1611;" key2="2" key3="\@"/>
    <key key0="ق" key1="&#1615;" key2="3" key3="\#"/>
    <key key0="ف" key1="&#1612;" key2="4" key3="$"/>
    <key key0="غ" key1="&#1573;" key2="5" key3="%"/>
    <key key0="ع" key1="&#8216;" key2="6" key3="^"/>
    <key key0="ه" key1="&#0247;" key2="7" key3="&amp;"/>
    <key key0="خ" key1="&#0215;" key2="8" key3="*"/>
    <key key0="ح" key1="&#1563;" key2="9" key3="(" key4=")"/>
    <key key0="ج" key1="&gt;" key2="0" key3="-" key4="_"/>
  </row>
  <row>
    <key key0="ش" key1="&#1616;" key4="loc tab"/>
    <key key0="س" key1="&#1613;"/>
    <key key0="ي" key1="[" key7="ئ"/>
    <key key0="ب" key1="]"/>
    <key key0="ل" key1="&#1604;&#1571;" key7="لا" key8="&#1604;&#1570;"/>
    <key key0="ا" key1="أ" key3="إ" key2="آ"/>
    <key key0="ت" key1="ـ" key7="ث"/>
    <key key0="ن" key1="&#1548;"/>
    <key key0="م" key1="/"/>
    <key key0="ك" key1=":"/>
  </row>
  <row>
    <key key0="ء" key1="&#1618;" key2="~"/>
    <key key0="ر" key1="}" key2="{"/>
    <key key0="ى" key1="&#1570;"/>
    <key key0="ة" key1="&#8217;"/>
    <key key0="و" key1="," key7="ؤ"/>
    <key key0="ز" key1="."/>
    <key key0="د" key1="&lt;" key2="=" key7="ذ"/>
    <key key0="ط" key1="&quot;" key2="&#1567;" key7="ظ"/>
    <key width="2.0" key0="backspace" key1="delete_last_word" key2="delete"/>
  </row>
</keyboard>
