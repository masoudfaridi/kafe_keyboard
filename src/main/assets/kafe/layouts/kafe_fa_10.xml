<?xml version="1.0" encoding="utf-8"?>
<!-- Kafe Keyboard: Persian, 10 columns, laid out like the common Persian phone keyboards.
     27 letters on their own keys; the 5 rare ones pair with their look-alikes on swipe-up (N):
       ض on ص · غ on ع · ظ on ط · ژ on ز · ذ on د   (and ؤ on و).
     ک and گ sit side by side on row 3. Digits stay top-right on row 1, symbols in their
     Persian PC places, half-space on ت (top-left) and on the bottom row. -->
<keyboard name="Persian 10 (Kafe)" script="persian" language="fa" bottom_row="false">
  <row>
    <key key0="ص" key7="ض" key2="۱" key4="loc esc"/>
    <key key0="ث" key2="۲" key1="~" key3="\@"/>
    <key key0="ق" key2="۳" key1="!" key3="\#"/>
    <key key0="ف" key2="۴" key1="﷼" key3="$"/>
    <key key0="ع" key7="غ" key2="۵" key1="،" key3="٪"/>
    <key key0="ه" key2="۶" key3="^"/>
    <key key0="خ" key2="۷" key3="&amp;"/>
    <key key0="ح" key2="۸" key3="*"/>
    <key key0="ج" key2="۹" key3="(" key4=")"/>
    <key key0="چ" key2="۰"/>
  </row>
  <row>
    <key key0="ش" key2="loc tab"/>
    <key key0="س"/>
    <key key0="ی" key2="ئ"/>
    <key key0="ب"/>
    <key key0="ل"/>
    <key key0="ا" key1="آ" key4="ء" key2="-" key3="_" key7="أ" key8="إ"/>
    <key key0="ت" key1="halfspace" key2="+"/>
    <key key0="ن"/>
    <key key0="م"/>
    <key key0="پ" key2="&#1567;"/>
  </row>
  <!-- 7 letters + backspace, widened to fill the 10 units. -->
  <row>
    <key width="1.15" key0="ط" key7="ظ"/>
    <key width="1.15" key0="ز" key7="ژ" key1="«" key2="»"/>
    <key width="1.15" key0="ر" key2="."/>
    <key width="1.15" key0="د" key7="ذ" key1=":" key2="؛"/>
    <key width="1.15" key0="و" key7="ؤ"/>
    <key width="1.15" key0="ک"/>
    <key width="1.15" key0="گ"/>
    <key width="1.95" key0="backspace" key1="delete_last_word" key2="delete"/>
  </row>
  <!-- Persian PC's own bottom row (half-space right of the space bar), scaled to 10 units. -->
  <row height="0.95">
    <key width="1.5" key0="ctrl" key1="loc switch_greekmath" key2="loc meta" key3="loc switch_clipboard" key7="switch_numeric"/>
    <key width="1.0" key0="fn" key1="loc alt" key2="loc change_method" key3="switch_emoji" key4="config" key6="loc toggle_true_black" key7="switch_gif"/>
    <key width="4.0" key0="space" key7="loc switch_forward" key8="loc switch_backward" key5="cursor_left" key6="cursor_right"/>
    <key width="1.0" key0="halfspace" key7="zwj"/>
    <key width="1.0" key0="loc compose" key7="up" key6="right" key5="left" key8="down" key1="doc_home" key2="loc page_up" key3="doc_end" key4="loc page_down"/>
    <key width="1.5" key0="enter" key1="loc voice_typing" key2="action"/>
  </row>
</keyboard>
